{
  "pluginId": "com.asc.fr.docspace",
  "sdkVersion": "2.2.0",
  "debug": false,
  "module": {
    "id": "decision-management-docspace",
    "value": "docspace",
    "displayName": "DocSpace",
    "sortIndex": 100
  },
  "assets": {
    "navigation": {
      "script": "com/asc/fr/docspace/web/dist/authentication.js",
      "style": "com/asc/fr/docspace/web/dist/authentication.css"
    }
  },
  "aliases": {
    "main":    { "from": "/docspace",         "to": "/client/docspace",              "public": false },
    "admin":   { "from": "/docspace/admin",   "to": "/client/docspace/admin",        "public": false },
    "debug":   { "from": "/docspace-debug",   "to": "/client/debug",        "public": false },
    "webhook": { "from": "/docspace/webhook", "to": "/api/import/docspace/webhook",  "public": true  },
    "events":  { "from": "/docspace/events",  "to": "/api/import/docspace/events",   "public": false }
  },
  "events": {
    "common": {},
    "backend": {
      "tenantReset": "tenantReset",
      "datasetUpdated": "datasetUpdated"
    },
    "frontend": {
      "filePicker": "filePicker"
    }
  },
  "limits": {
    "jsonBodyBytes": 262144,
    "webhookBodyBytes": 1048576,
    "exportUploadBytes": 10485760,
    "docSpaceUploadBytes": 52428800,
    "docSpaceDownloadBytes": 52428800
  },
  "schedulers": {
    "webhookReconciliation": {
      "initialDelayMillis": 5000,
      "periodMillis": 300000
    },
    "syncLinkReconciliation": {
      "initialDelayMillis": 30000,
      "periodMillis": 600000,
      "staleAfterMillis": 600000
    }
  },
  "endpoints": {
    "setup":            "/client/setup",
    "docspace":         "/client/docspace",
    "docspaceAdmin":    "/client/docspace/admin",
    "pluginDebug":      "/client/debug",
    "session":          "/api/session",
    "login":            "/api/login",
    "logout":           "/api/logout",
    "reset":            "/api/reset",
    "importFile":       "/api/import/docspace/file",
    "folders":          "/api/import/docspace/folders",
    "webhookCallback":  "/api/import/docspace/webhook",
    "webhookRegister":  "/api/import/docspace/webhook/register",
    "syncEvents":       "/api/import/docspace/events",
    "exportConfig":     "/api/export/config",
    "exportUpload":     "/api/export/upload",
    "exportTrigger":    "/api/export/trigger"
  }
}
